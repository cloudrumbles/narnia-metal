+void
+vkr_cs_encoder_flush_written(struct vkr_cs_encoder *enc, uint32_t ctx_id)
+{
+   if (!vkr_net_hooks || !enc->written_begin)
+      return;
+
+   mtx_lock(&enc->mutex);
+   const struct vkr_resource *res = enc->stream.resource;
+   if (res && enc->written_begin >= res->u.data &&
+       enc->written_end <= res->u.data + res->size) {
+      vkr_net_hooks->mem_written(ctx_id, res->res_id,
+                                 enc->written_begin - res->u.data,
+                                 enc->written_end - enc->written_begin);
+   }
+   enc->written_begin = NULL;
+   enc->written_end = NULL;
+   mtx_unlock(&enc->mutex);
