@@ -435,8 +618,16 @@ vkr_device_destroy(struct vkr_context *ctx, struct vkr_device *dev, bool destroy
 
    mtx_destroy(&dev->free_sync_mutex);
 
-   if (destroy_vk || ctx->on_worker_thread)
+   if (destroy_vk || ctx->on_worker_thread) {
+      if (dev->null_buffer_view)
+         vk->DestroyBufferView(device, dev->null_buffer_view, NULL);
+      if (dev->null_buffer)
+         vk->DestroyBuffer(device, dev->null_buffer, NULL);
+      if (dev->null_memory)
+         vk->FreeMemory(device, dev->null_memory, NULL);
       vk->DestroyDevice(device, NULL);
+   }
+   mtx_destroy(&dev->null_mutex);
 
    list_del(&dev->base.track_head);
 
