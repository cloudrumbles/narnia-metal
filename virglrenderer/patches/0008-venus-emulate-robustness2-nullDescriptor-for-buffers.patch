+/* narnia-metal: robustness2 nullDescriptor emulation.
+ *
+ * Reads through a null buffer descriptor must return zero. We keep one
+ * zero-filled host-visible buffer (and an R32_UINT view of it) per device and
+ * write it in place of VK_NULL_HANDLE. Writes through a null storage
+ * descriptor must be discarded; here they land in the dummy buffer instead,
+ * so a later null read could see them (accepted). Null image views and
+ * samplers are left alone: MoltenVK writes nil into its argument buffers,
+ * and Metal returns zero for nil textures.
+ */
+#define VKR_NULL_BUFFER_SIZE (1u << 20)
+#define VKR_NULL_RANGE_MAX 65536u
+
+VkBuffer
+vkr_device_null_buffer(struct vkr_device *dev)
+{
+   struct vn_device_proc_table *vk = &dev->proc_table;
+   VkDevice device = dev->base.handle.device;
+
+   mtx_lock(&dev->null_mutex);
+   if (dev->null_buffer)
+      goto out; /* created, or tried and failed */
+
+   const VkBufferCreateInfo buf_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = VKR_NULL_BUFFER_SIZE,
+      .usage = VK_BUFFER_USAGE_UNIFORM_BUFFER_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+               VK_BUFFER_USAGE_UNIFORM_TEXEL_BUFFER_BIT |
+               VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT |
+               VK_BUFFER_USAGE_VERTEX_BUFFER_BIT | VK_BUFFER_USAGE_INDEX_BUFFER_BIT |
+               VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkMemoryRequirements req;
+   if (vk->CreateBuffer(device, &buf_info, NULL, &dev->null_buffer) != VK_SUCCESS) {
+      dev->null_buffer = VK_NULL_HANDLE;
+      goto out;
+   }
+   vk->GetBufferMemoryRequirements(device, dev->null_buffer, &req);
+
+   const VkPhysicalDeviceMemoryProperties *mp = &dev->physical_device->memory_properties;
+   const VkMemoryPropertyFlags want =
+      VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+   uint32_t type = UINT32_MAX;
+   for (uint32_t i = 0; i < mp->memoryTypeCount; i++) {
+      if ((req.memoryTypeBits & (1u << i)) &&
+          (mp->memoryTypes[i].propertyFlags & want) == want) {
+         type = i;
+         break;
+      }
+   }
+   if (type == UINT32_MAX) {
+      for (uint32_t i = 0; i < mp->memoryTypeCount && type == UINT32_MAX; i++) {
+         if (req.memoryTypeBits & (1u << i))
+            type = i;
+      }
+   }
+   const VkMemoryAllocateInfo alloc = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = req.size,
+      .memoryTypeIndex = type,
+   };
+   if (type == UINT32_MAX ||
+       vk->AllocateMemory(device, &alloc, NULL, &dev->null_memory) != VK_SUCCESS) {
+      dev->null_memory = VK_NULL_HANDLE;
+      goto fail;
+   }
+   if (vk->BindBufferMemory(device, dev->null_buffer, dev->null_memory, 0) != VK_SUCCESS)
+      goto fail;
+
+   if (mp->memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT) {
+      void *ptr;
+      if (vk->MapMemory(device, dev->null_memory, 0, VK_WHOLE_SIZE, 0, &ptr) == VK_SUCCESS) {
+         memset(ptr, 0, req.size);
+         if (!(mp->memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT)) {
+            const VkMappedMemoryRange range = {
+               .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE,
+               .memory = dev->null_memory,
+               .size = VK_WHOLE_SIZE,
+            };
+            vk->FlushMappedMemoryRanges(device, 1, &range);
+         }
+         vk->UnmapMemory(device, dev->null_memory);
+      }
+   }
+
+   const VkBufferViewCreateInfo view_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_VIEW_CREATE_INFO,
+      .buffer = dev->null_buffer,
+      .format = VK_FORMAT_R32_UINT,
+      .offset = 0,
+      .range = VKR_NULL_RANGE_MAX,
+   };
+   if (vk->CreateBufferView(device, &view_info, NULL, &dev->null_buffer_view) !=
+       VK_SUCCESS) {
+      dev->null_buffer_view = VK_NULL_HANDLE;
+      goto fail;
+   }
+   goto out;
+
+fail:
+   /* null_buffer stays set so we don't retry and teardown frees what exists */
+out:
+   mtx_unlock(&dev->null_mutex);
+   return dev->null_buffer_view ? dev->null_buffer : VK_NULL_HANDLE;
+}
+
+static VkDeviceSize
+vkr_null_range(VkDeviceSize range)
+{
+   return range == VK_WHOLE_SIZE || range > VKR_NULL_RANGE_MAX ? VKR_NULL_RANGE_MAX : range;
+}
+
+void
+vkr_device_fix_null_writes(struct vkr_device *dev,
+                           uint32_t count,
+                           const VkWriteDescriptorSet *writes)
+{
+   if (!dev->emulate_null_descriptor)
+      return;
+
+   for (uint32_t i = 0; i < count; i++) {
+      const VkWriteDescriptorSet *w = &writes[i];
+      switch (w->descriptorType) {
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+      case VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC:
+      case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER_DYNAMIC:
+         for (uint32_t j = 0; j < w->descriptorCount; j++) {
+            VkDescriptorBufferInfo *b = (VkDescriptorBufferInfo *)&w->pBufferInfo[j];
+            if (b->buffer)
+               continue;
+            VkBuffer null = vkr_device_null_buffer(dev);
+            if (!null)
+               continue;
+            b->buffer = null;
+            b->offset = 0;
+            b->range = vkr_null_range(b->range);
+         }
+         break;
+      case VK_DESCRIPTOR_TYPE_UNIFORM_TEXEL_BUFFER:
+      case VK_DESCRIPTOR_TYPE_STORAGE_TEXEL_BUFFER:
+         for (uint32_t j = 0; j < w->descriptorCount; j++) {
+            VkBufferView *v = (VkBufferView *)&w->pTexelBufferView[j];
+            if (!*v && vkr_device_null_buffer(dev))
+               *v = dev->null_buffer_view;
+         }
+         break;
+      default:
+         break;
+      }
+   }
+}
+
+/* null vertex/index buffers (offset must be 0 for null in the spec) */
+void
+vkr_device_fix_null_buffers(struct vkr_device *dev,
+                            uint32_t count,
+                            const VkBuffer *buffers,
+                            const VkDeviceSize *offsets,
+                            const VkDeviceSize *sizes)
+{
+   if (!dev->emulate_null_descriptor)
+      return;
+
+   for (uint32_t i = 0; i < count; i++) {
+      if (buffers[i])
+         continue;
+      VkBuffer null = vkr_device_null_buffer(dev);
+      if (!null)
+         continue;
+      ((VkBuffer *)buffers)[i] = null;
+      if (offsets)
+         ((VkDeviceSize *)offsets)[i] = 0;
+      if (sizes)
+         ((VkDeviceSize *)sizes)[i] = VK_WHOLE_SIZE;
+   }
+}
