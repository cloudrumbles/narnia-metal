diff --git a/src/venus/vkr_physical_device.h b/src/venus/vkr_physical_device.h
index b0b6691..f9ae578 100644
--- a/src/venus/vkr_physical_device.h
+++ b/src/venus/vkr_physical_device.h
@@ -25,6 +25,11 @@ struct vkr_physical_device {
    bool EXT_external_memory_dma_buf;
 
    bool KHR_external_fence_fd;
+
+   /* narnia-metal: VK_EXT_depth_clip_enable is advertised but emulated with
+    * depth clamp, because the host lacks it (MoltenVK) and DXVK requires it
