diff --git a/src/venus/vkr_pipeline.c b/src/venus/vkr_pipeline.c
index 76709b9..43f1ed3 100644
--- a/src/venus/vkr_pipeline.c
+++ b/src/venus/vkr_pipeline.c
@@ -6,6 +6,7 @@
 #include "vkr_pipeline.h"
 
 #include "vkr_pipeline_gen.h"
+#include "vkr_physical_device.h"
 
 static void
 vkr_dispatch_vkCreateShaderModule(struct vn_dispatch_context *dispatch,
@@ -114,6 +115,33 @@ vkr_dispatch_vkCreateGraphicsPipelines(struct vn_dispatch_context *dispatch,
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct object_array arr;
 
+   /* narnia-metal: emulate VK_EXT_depth_clip_enable with depth clamp.
+    * depthClipEnable = false means "don't clip against near/far", which is
+    * what depth clamping does; true is the host's default.
+    */
+   if (dev->physical_device->emulate_depth_clip_enable) {
+      for (uint32_t i = 0; i < args->createInfoCount; i++) {
+         VkPipelineRasterizationStateCreateInfo *rs =
+            (VkPipelineRasterizationStateCreateInfo *)args->pCreateInfos[i]
+               .pRasterizationState;
+         if (!rs)
+            continue;
+         VkBaseOutStructure *prev = (VkBaseOutStructure *)rs;
+         while (prev->pNext) {
+            if (prev->pNext->sType ==
+                VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_DEPTH_CLIP_STATE_CREATE_INFO_EXT) {
+               const VkPipelineRasterizationDepthClipStateCreateInfoEXT *clip =
+                  (const void *)prev->pNext;
+               if (!clip->depthClipEnable)
+                  rs->depthClampEnable = VK_TRUE;
+               prev->pNext = prev->pNext->pNext;
+            } else {
+               prev = prev->pNext;
+            }
+         }
+      }
+   }
+
    if (vkr_graphics_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
       return;
 
