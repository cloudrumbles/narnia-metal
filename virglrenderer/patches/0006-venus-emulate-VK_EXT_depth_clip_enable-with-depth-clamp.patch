diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index cf04842..f467865 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -303,6 +303,29 @@ vkr_physical_device_init_extensions(struct vkr_physical_device *physical_dev)
          physical_dev->KHR_external_fence_fd = false;
    }
 
+   /* narnia-metal: emulate VK_EXT_depth_clip_enable when spoofing for
+    * translation layers and the host doesn't have it
+    */
+   if (vkr_spoofed_core_features) {
+      bool have = false;
+      for (uint32_t i = 0; i < advertised_count; i++)
+         have |= !strcmp(exts[i].extensionName, "VK_EXT_depth_clip_enable");
+      const uint32_t spec_ver = vkr_extension_get_spec_version("VK_EXT_depth_clip_enable");
+      if (!have && spec_ver && advertised_count < count + 1) {
+         VkExtensionProperties *grown =
+            realloc(exts, sizeof(*exts) * (advertised_count + 1));
+         if (grown) {
+            exts = grown;
+            exts[advertised_count] = (VkExtensionProperties){
+               .extensionName = "VK_EXT_depth_clip_enable",
+               .specVersion = spec_ver,
+            };
+            advertised_count++;
+            physical_dev->emulate_depth_clip_enable = true;
+         }
+      }
+   }
+
    physical_dev->extensions = realloc(exts, sizeof(*exts) * advertised_count);
    physical_dev->extension_count = advertised_count;
 }
