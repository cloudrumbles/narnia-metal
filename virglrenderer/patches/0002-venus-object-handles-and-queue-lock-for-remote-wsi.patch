+/* narnia-metal: host handles behind Venus object ids, for remote WSI.
+ * Dispatchable handles are returned as void *, non-dispatchable as uint64_t.
+ */
+struct vkr_renderer_present_handles {
+   void *instance;
+   void *physical_device;
+   void *device;
+   void *queue;
+   uint64_t image;
+};
+
+bool
+vkr_renderer_get_present_handles(uint32_t ctx_id,
+                                 uint64_t device_id,
+                                 uint64_t queue_id,
+                                 uint64_t image_id,
+                                 struct vkr_renderer_present_handles *out);
+
+/* narnia-metal: external synchronization of a VkQueue shared with vkr */
+bool
+vkr_renderer_lock_queue(uint32_t ctx_id, uint64_t queue_id);
+
+void
+vkr_renderer_unlock_queue(uint32_t ctx_id, uint64_t queue_id);
+
 /* narnia-metal: CPU pointer of a shm or host-pointer resource */
 bool
 vkr_renderer_get_resource_data(uint32_t ctx_id,
