           sizeof(*args->pProperties) * count);
 }
 
+/* narnia-metal: see vkr_renderer_set_spoofed_features */
+static void
+vkr_spoof_core_features(VkPhysicalDeviceFeatures *features)
+{
+   VkBool32 *bools = (VkBool32 *)features;
+   for (uint32_t i = 0; i < sizeof(*features) / sizeof(VkBool32); i++) {
+      if (vkr_spoofed_core_features & (1ull << i))
+         bools[i] = VK_TRUE;
+   }
+}
