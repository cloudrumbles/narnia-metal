diff --git a/src/venus/vkr_device.c b/src/venus/vkr_device.c
index 1f2b998..55e0d06 100644
--- a/src/venus/vkr_device.c
+++ b/src/venus/vkr_device.c
@@ -127,6 +127,29 @@ vkr_dispatch_vkCreateDevice(struct vn_dispatch_context *dispatch,
          return;
    }
 
+   /* narnia-metal: drop spoofed features the host doesn't really have */
+   if (vkr_spoofed_core_features) {
+      VkPhysicalDeviceFeatures real;
+      physical_dev->proc_table.GetPhysicalDeviceFeatures(
+         physical_dev->base.handle.physical_device, &real);
+      VkPhysicalDeviceFeatures *requested[2] = {
+         (VkPhysicalDeviceFeatures *)args->pCreateInfo->pEnabledFeatures, NULL };
+      for (const VkBaseInStructure *s = args->pCreateInfo->pNext; s; s = s->pNext) {
+         if (s->sType == VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2)
+            requested[1] = &((VkPhysicalDeviceFeatures2 *)s)->features;
+      }
+      const VkBool32 *have = (const VkBool32 *)&real;
+      for (uint32_t r = 0; r < 2; r++) {
+         if (!requested[r])
+            continue;
+         VkBool32 *want = (VkBool32 *)requested[r];
+         for (uint32_t i = 0; i < sizeof(real) / sizeof(VkBool32); i++) {
+            if ((vkr_spoofed_core_features & (1ull << i)) && !have[i])
+               want[i] = VK_FALSE;
+         }
+      }
+   }
+
    /* narnia-metal: device extensions the embedder wants, if supported */
    const char *extra_exts[16];
    uint32_t extra_count = 0;
