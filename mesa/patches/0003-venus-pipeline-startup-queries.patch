+static void
+vn_physical_device_prefetch_image_formats(
+   struct vn_physical_device *physical_dev,
+   const VkPhysicalDeviceImageFormatInfo2 *likes,
+   uint32_t combo_count)
+{
+   struct vn_ring *ring = physical_dev->instance->ring.ring;
+   VkPhysicalDevice pdev = vn_physical_device_to_handle(physical_dev);
+   VkFormat formats[VN_PREFETCH_MAX_FORMATS];
+   const uint32_t format_count = vn_prefetch_format_list(formats);
+   const uint32_t total = format_count * combo_count;
+
+   STACK_ARRAY(VkPhysicalDeviceImageFormatInfo2, infos, total);
+   STACK_ARRAY(VkImageFormatProperties2, props, total);
+   STACK_ARRAY(VkResult, results, total);
+   void *cmd_data = NULL;
+
+   size_t cmd_size = 0, reply_size = 0;
+   for (uint32_t k = 0; k < total; k++) {
+      infos[k] = likes[k / format_count];
+      infos[k].format = formats[k % format_count];
+      props[k] = (VkImageFormatProperties2){
+         .sType = VK_STRUCTURE_TYPE_IMAGE_FORMAT_PROPERTIES_2 };
+      cmd_size += vn_sizeof_vkGetPhysicalDeviceImageFormatProperties2(
+         pdev, &infos[k], &props[k]);
+      reply_size += vn_sizeof_vkGetPhysicalDeviceImageFormatProperties2_reply(
+         pdev, &infos[k], &props[k]);
+   }
+
+   cmd_data = malloc(cmd_size);
+   if (!cmd_data)
+      goto out;
+   struct vn_ring_submit_command submit;
+   struct vn_cs_encoder *enc = vn_ring_submit_command_init(
+      ring, &submit, cmd_data, cmd_size, reply_size);
+   for (uint32_t k = 0; k < total; k++) {
+      vn_encode_vkGetPhysicalDeviceImageFormatProperties2(
+         enc, VK_COMMAND_GENERATE_REPLY_BIT_EXT, pdev, &infos[k], &props[k]);
+   }
+   vn_ring_submit_command(ring, &submit);
+
+   struct vn_cs_decoder *dec = vn_ring_get_command_reply(ring, &submit);
+   if (!dec)
+      goto out;
+   for (uint32_t k = 0; k < total; k++) {
+      results[k] = vn_decode_vkGetPhysicalDeviceImageFormatProperties2_reply(
+         dec, pdev, &infos[k], &props[k]);
+   }
+   vn_ring_free_command_reply(ring, &submit);
+
+   for (uint32_t k = 0; k < total; k++) {
+      if (results[k] == VK_SUCCESS) {
+         vn_sanitize_image_format_properties(physical_dev, &infos[k], NULL,
+                                             &props[k]);
+      } else if (results[k] != VK_ERROR_FORMAT_NOT_SUPPORTED &&
+                 results[k] != VK_ERROR_IMAGE_USAGE_NOT_SUPPORTED_KHR) {
+         continue;
+      }
+      uint8_t key[BLAKE3_KEY_LEN] = { 0 };
+      if (vn_image_get_image_format_key(physical_dev, &infos[k], &props[k],
+                                        key))
+         vn_image_store_format_in_cache(physical_dev, key, &props[k],
+                                        results[k]);
+   }
+
+out:
+   free(cmd_data);
+   STACK_ARRAY_FINISH(infos);
+   STACK_ARRAY_FINISH(props);
+   STACK_ARRAY_FINISH(results);
+}
+
+static uint64_t
+vn_image_combo_key(const VkPhysicalDeviceImageFormatInfo2 *info)
+{
+   return ((uint64_t)info->type << 60) ^ ((uint64_t)info->tiling << 56) ^
+          ((uint64_t)info->usage << 24) ^ (uint64_t)info->flags ^ (1ull << 63);
+}
+
+/* Prefetch all formats for this query's other parameters, once per distinct
+ * (type, tiling, usage, flags).  Only plain queries are handled; anything
+ * with a pNext chain goes through the normal path.  vkd3d-proton asks every
+ * format with and without the sparse flags, so when the renderer can do
+ * sparse images the other variant is fetched in the same round trip.
+ */
+static void
+vn_physical_device_maybe_prefetch_image_formats(
+   struct vn_physical_device *physical_dev,
+   const VkPhysicalDeviceImageFormatInfo2 *info,
+   const VkImageFormatProperties2 *props)
+{
+   if (VN_PERF(NO_FORMAT_PREFETCH) || info->pNext || props->pNext)
+      return;
+
+   const VkImageCreateFlags sparse_flags =
+      VK_IMAGE_CREATE_SPARSE_BINDING_BIT |
+      VK_IMAGE_CREATE_SPARSE_RESIDENCY_BIT | VK_IMAGE_CREATE_SPARSE_ALIASED_BIT;
+   VkPhysicalDeviceImageFormatInfo2 likes[2];
+   uint32_t like_count = 0;
+   likes[like_count++] = *info;
+   if (physical_dev->base.vk.supported_features.sparseBinding &&
+       (info->flags == 0 || info->flags == sparse_flags)) {
+      likes[like_count] = *info;
+      likes[like_count].flags = info->flags ? 0 : sparse_flags;
+      like_count++;
+   }
+
+   VkPhysicalDeviceImageFormatInfo2 todo[2];
+   uint32_t todo_count = 0;
+   simple_mtx_lock(&physical_dev->mutex);
+   for (uint32_t l = 0; l < like_count; l++) {
+      const uint64_t combo = vn_image_combo_key(&likes[l]);
+      bool seen = false;
+      for (uint32_t i = 0; i < physical_dev->prefetched_combo_count; i++)
+         seen = seen || physical_dev->prefetched_combos[i] == combo;
+      if (seen || physical_dev->prefetched_combo_count >=
+                     ARRAY_SIZE(physical_dev->prefetched_combos))
+         continue;
+      physical_dev->prefetched_combos[physical_dev->prefetched_combo_count++] =
+         combo;
+      todo[todo_count++] = likes[l];
+   }
+   simple_mtx_unlock(&physical_dev->mutex);
+
+   if (todo_count)
+      vn_physical_device_prefetch_image_formats(physical_dev, todo, todo_count);
+}
