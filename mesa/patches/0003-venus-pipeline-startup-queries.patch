+   if (!f) return;
+   unsigned long long tc = 0, tn = 0;
+   for (int i = 0; i < NM_RT_TAGS; i++) {
+      if (nm_rt_count[i]) {
+         fprintf(f, "NMRT pid=%d tag=%d calls=%llu waits=%llu ms=%.1f\n", getpid(), i,
+                 nm_rt_calls[i], nm_rt_count[i], nm_rt_ns[i] / 1e6);
+         tc += nm_rt_count[i]; tn += nm_rt_ns[i];
+      }
+   }
+   fprintf(f, "NMRT total waits=%llu ms=%.1f\n", tc, tn / 1e6);
+   if (path) fclose(f);
+}
