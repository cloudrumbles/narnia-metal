+static int
+vn_prefetch_format_index(VkFormat format)
+{
+   if (format >= 1 && format <= 184)
+      return format - 1;
+   VkFormat formats[VN_PREFETCH_MAX_FORMATS];
+   const uint32_t count = vn_prefetch_format_list(formats);
+   for (uint32_t i = 184; i < count; i++) {
+      if (formats[i] == format)
+         return i;
+   }
+   return -1;
+}
+
+/* sample counts fetched together; apps ask for a few of them in a row */
+static const VkSampleCountFlagBits vn_sparse_prefetch_samples[] = {
+   VK_SAMPLE_COUNT_1_BIT, VK_SAMPLE_COUNT_2_BIT, VK_SAMPLE_COUNT_4_BIT,
+   VK_SAMPLE_COUNT_8_BIT,
+};
+
+static void
+vn_physical_device_prefetch_sparse_formats(
+   struct vn_physical_device *physical_dev,
+   const VkPhysicalDeviceSparseImageFormatInfo2 *likes,
+   struct vn_sparse_format_entry *const *entries,
+   uint32_t combo_count)
+{
+   struct vn_ring *ring = physical_dev->instance->ring.ring;
+   VkPhysicalDevice pdev = vn_physical_device_to_handle(physical_dev);
+   VkFormat formats[VN_PREFETCH_MAX_FORMATS];
+   const uint32_t format_count = vn_prefetch_format_list(formats);
+   const uint32_t total = format_count * combo_count;
+   const uint32_t cap = ARRAY_SIZE(entries[0][0].props) + 1;
+
+   STACK_ARRAY(VkPhysicalDeviceSparseImageFormatInfo2, infos, total);
+   STACK_ARRAY(uint32_t, counts, total);
+   STACK_ARRAY(VkSparseImageFormatProperties2, all_props, total * 4);
+   VkSparseImageFormatProperties2(*props)[4] = (void *)all_props;
+   void *cmd_data = NULL;
+
+   size_t cmd_size = 0, reply_size = 0;
+   for (uint32_t k = 0; k < total; k++) {
+      infos[k] = likes[k / format_count];
+      infos[k].format = formats[k % format_count];
+      counts[k] = cap;
+      for (uint32_t j = 0; j < cap; j++) {
+         props[k][j] = (VkSparseImageFormatProperties2){
+            .sType = VK_STRUCTURE_TYPE_SPARSE_IMAGE_FORMAT_PROPERTIES_2 };
+      }
+      cmd_size += vn_sizeof_vkGetPhysicalDeviceSparseImageFormatProperties2(
+         pdev, &infos[k], &counts[k], props[k]);
+      reply_size +=
+         vn_sizeof_vkGetPhysicalDeviceSparseImageFormatProperties2_reply(
+            pdev, &infos[k], &counts[k], props[k]);
+   }
+
+   cmd_data = malloc(cmd_size);
+   if (!cmd_data)
+      goto out;
+   struct vn_ring_submit_command submit;
+   struct vn_cs_encoder *enc = vn_ring_submit_command_init(
+      ring, &submit, cmd_data, cmd_size, reply_size);
+   for (uint32_t k = 0; k < total; k++) {
+      vn_encode_vkGetPhysicalDeviceSparseImageFormatProperties2(
+         enc, VK_COMMAND_GENERATE_REPLY_BIT_EXT, pdev, &infos[k], &counts[k],
+         props[k]);
+   }
+   vn_ring_submit_command(ring, &submit);
+
+   struct vn_cs_decoder *dec = vn_ring_get_command_reply(ring, &submit);
+   if (!dec)
+      goto out;
+   for (uint32_t k = 0; k < total; k++) {
+      vn_decode_vkGetPhysicalDeviceSparseImageFormatProperties2_reply(
+         dec, pdev, &infos[k], &counts[k], props[k]);
+      const int idx = vn_prefetch_format_index(infos[k].format);
+      /* a full array may have been truncated: leave those uncached */
+      if (idx < 0 || counts[k] >= cap)
+         continue;
+      struct vn_sparse_format_entry *e = &entries[k / format_count][idx];
+      e->count = counts[k];
+      for (uint32_t j = 0; j < counts[k]; j++)
+         e->props[j] = props[k][j].properties;
+      e->valid = true;
+   }
+   vn_ring_free_command_reply(ring, &submit);
+
+out:
+   free(cmd_data);
+   STACK_ARRAY_FINISH(infos);
+   STACK_ARRAY_FINISH(counts);
+   STACK_ARRAY_FINISH(all_props);
+}
+
+static uint64_t
+vn_sparse_combo_key(const VkPhysicalDeviceSparseImageFormatInfo2 *info,
+                    VkSampleCountFlagBits samples)
+{
+   return ((uint64_t)info->type << 60) ^ ((uint64_t)info->tiling << 56) ^
+          ((uint64_t)samples << 48) ^ ((uint64_t)info->usage << 8) ^ 1;
+}
+
+/* answer from the prefetched table; false if the renderer must be asked */
+static bool
+vn_physical_device_sparse_from_cache(
+   struct vn_physical_device *physical_dev,
+   const VkPhysicalDeviceSparseImageFormatInfo2 *info,
+   uint32_t *pPropertyCount,
+   VkSparseImageFormatProperties2 *pProperties)
+{
+   if (VN_PERF(NO_FORMAT_PREFETCH) || info->pNext)
+      return false;
+   const int idx = vn_prefetch_format_index(info->format);
+   if (idx < 0)
+      return false;
+
+   const uint64_t key = vn_sparse_combo_key(info, info->samples);
+   struct vn_sparse_format_combo *c = NULL;
+   struct vn_sparse_format_combo *fresh[ARRAY_SIZE(vn_sparse_prefetch_samples) + 1];
+   VkPhysicalDeviceSparseImageFormatInfo2 likes[ARRAY_SIZE(fresh)];
+   struct vn_sparse_format_entry *fresh_entries[ARRAY_SIZE(fresh)];
+   uint32_t fresh_count = 0;
+
+   simple_mtx_lock(&physical_dev->mutex);
+   for (uint32_t i = 0; i < physical_dev->sparse_combo_count; i++) {
+      if (physical_dev->sparse_combos[i].combo == key) {
+         c = &physical_dev->sparse_combos[i];
+         break;
+      }
+   }
+   if (!c) {
+      /* the asked-for sample count first, then its usual companions */
+      VkSampleCountFlagBits wanted[ARRAY_SIZE(fresh)];
+      uint32_t wanted_count = 0;
+      wanted[wanted_count++] = info->samples;
+      for (uint32_t i = 0; i < ARRAY_SIZE(vn_sparse_prefetch_samples); i++) {
+         if (vn_sparse_prefetch_samples[i] != info->samples)
+            wanted[wanted_count++] = vn_sparse_prefetch_samples[i];
+      }
+      for (uint32_t i = 0; i < wanted_count; i++) {
+         const uint64_t k = vn_sparse_combo_key(info, wanted[i]);
+         bool exists = false;
+         for (uint32_t j = 0; j < physical_dev->sparse_combo_count; j++)
+            exists = exists || physical_dev->sparse_combos[j].combo == k;
+         if (exists ||
+             physical_dev->sparse_combo_count >=
+                ARRAY_SIZE(physical_dev->sparse_combos))
+            continue;
+         struct vn_sparse_format_combo *n =
+            &physical_dev->sparse_combos[physical_dev->sparse_combo_count];
+         n->entries = calloc(VN_PREFETCH_MAX_FORMATS, sizeof(*n->entries));
+         if (!n->entries)
+            continue;
+         n->combo = k;
+         physical_dev->sparse_combo_count++;
+         likes[fresh_count] = *info;
+         likes[fresh_count].samples = wanted[i];
+         fresh_entries[fresh_count] = n->entries;
+         fresh[fresh_count++] = n;
+         if (i == 0)
+            c = n; /* the first one is the one asked for */
+      }
+   }
+   simple_mtx_unlock(&physical_dev->mutex);
+   if (!c)
+      return false;
+
+   if (fresh_count) {
+      vn_physical_device_prefetch_sparse_formats(
+         physical_dev, likes, fresh_entries, fresh_count);
+      for (uint32_t i = 0; i < fresh_count; i++)
+         p_atomic_set(&fresh[i]->ready, true);
+   }
+   if (!p_atomic_read(&c->ready) || !c->entries[idx].valid)
+      return false;
+
+   const struct vn_sparse_format_entry *e = &c->entries[idx];
+   if (!pProperties) {
+      *pPropertyCount = e->count;
+   } else {
+      const uint32_t n = MIN2(*pPropertyCount, e->count);
+      for (uint32_t i = 0; i < n; i++)
+         pProperties[i].properties = e->props[i];
+      *pPropertyCount = n;
+   }
+   return true;
+}
