+   if (!VN_PERF(NO_PIPELINED_CREATE)) {
+      /* narnia-metal: the requirements query only needs the buffer's id,
+       * which we chose, so send it right behind the create and wait once.
+       * (If the create fails on the renderer the query makes the renderer
