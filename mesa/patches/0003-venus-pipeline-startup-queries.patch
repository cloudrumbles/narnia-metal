-      &buf->requirements.memory);
+   const VkBufferMemoryRequirementsInfo2 reqs_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_REQUIREMENTS_INFO_2,
+      .buffer = buf_handle,
+   };
