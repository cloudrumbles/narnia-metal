+/* narnia-metal: create the image and fetch its memory requirements in one
+ * round trip (see vn_buffer_init)
+ */
+static VkResult
+vn_image_create_with_reqs_pipelined(struct vn_device *dev,
+                                    const VkImageCreateInfo *create_info,
+                                    struct vn_image *img,
+                                    uint32_t plane_count)
+{
+   struct vn_ring *ring = dev->primary_ring;
+   VkDevice device = vn_device_to_handle(dev);
+   VkImage image = vn_image_to_handle(img);
+   const uint32_t max_planes = ARRAY_SIZE(img->requirements);
+   assert(plane_count && plane_count <= max_planes);
+
+   for (uint32_t i = 0; i < plane_count; i++) {
+      img->requirements[i].memory.sType =
+         VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2;
+      img->requirements[i].memory.pNext = &img->requirements[i].dedicated;
+      img->requirements[i].dedicated.sType =
+         VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS;
+      img->requirements[i].dedicated.pNext = NULL;
+   }
+
+   VkImagePlaneMemoryRequirementsInfo plane_infos[ARRAY_SIZE(img->requirements)];
+   VkImageMemoryRequirementsInfo2 infos[ARRAY_SIZE(img->requirements)];
+   struct vn_ring_submit_command create_submit;
+   struct vn_ring_submit_command reqs_submits[ARRAY_SIZE(img->requirements)];
+
+   vn_ring_defer_reply_waits(true);
+   vn_submit_vkCreateImage(ring, VK_COMMAND_GENERATE_REPLY_BIT_EXT, device,
+                           create_info, NULL, &image, &create_submit);
+   for (uint32_t i = 0; i < plane_count; i++) {
+      infos[i] = (VkImageMemoryRequirementsInfo2){
+         .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
+         .image = image,
+      };
+      if (plane_count > 1) {
+         plane_infos[i] = (VkImagePlaneMemoryRequirementsInfo){
+            .sType = VK_STRUCTURE_TYPE_IMAGE_PLANE_MEMORY_REQUIREMENTS_INFO,
+            .planeAspect = VK_IMAGE_ASPECT_PLANE_0_BIT << i,
+         };
+         infos[i].pNext = &plane_infos[i];
+      }
+      vn_submit_vkGetImageMemoryRequirements2(
+         ring, VK_COMMAND_GENERATE_REPLY_BIT_EXT, device, &infos[i],
+         &img->requirements[i].memory, &reqs_submits[i]);
+   }
+   vn_ring_defer_reply_waits(false);
+
+   bool ok = true;
+   vn_ring_wait_command_reply(ring, &create_submit);
+   ok = ok && vn_ring_get_command_reply(ring, &create_submit);
+   for (uint32_t i = 0; i < plane_count; i++) {
+      vn_ring_wait_command_reply(ring, &reqs_submits[i]);
+      ok = ok && vn_ring_get_command_reply(ring, &reqs_submits[i]);
+   }
+   if (!ok) {
+      /* all or nothing, the commands are already queued */
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+
+   VkResult result = vn_decode_vkCreateImage_reply(
+      &create_submit.reply, device, create_info, NULL, &image);
+   for (uint32_t i = 0; i < plane_count; i++) {
+      vn_decode_vkGetImageMemoryRequirements2_reply(
+         &reqs_submits[i].reply, device, &infos[i],
+         &img->requirements[i].memory);
+   }
+   vn_ring_free_command_reply(ring, &create_submit);
+   for (uint32_t i = 0; i < plane_count; i++)
+      vn_ring_free_command_reply(ring, &reqs_submits[i]);
+
+   if (result == VK_SUCCESS && plane_count == 1 && img->deferred) {
+      /* AHB backed image requires dedicated allocation */
+      img->requirements[0].dedicated.prefersDedicatedAllocation = VK_TRUE;
+      img->requirements[0].dedicated.requiresDedicatedAllocation = VK_TRUE;
+   }
+   return result;
+}
