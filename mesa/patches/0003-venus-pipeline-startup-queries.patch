+/* narnia-metal: apps ask about buffer requirements for a series of usage
+ * combinations at startup (DXVK: TRANSFER_SRC|DST plus one more bit each).
+ * Each first-of-a-kind query would cost a round trip, so on the first miss we
+ * ask for all the likely combinations in one go.
+ */
+static void
+vn_buffer_prefetch_reqs(struct vn_device *dev,
+                        const VkBufferCreateInfo *like)
+{
+   struct vn_buffer_reqs_cache *cache = &dev->buffer_reqs_cache;
+   /* only usages the app could legally use on this device */
+   VkBufferUsageFlags bits[14];
+   uint32_t bit_count = 0;
+   for (VkBufferUsageFlags b = 0x1; b <= 0x100; b <<= 1)
+      bits[bit_count++] = b;
+   if (dev->base.vk.enabled_extensions.EXT_conditional_rendering)
+      bits[bit_count++] = 0x200;
+   if (dev->base.vk.enabled_extensions.EXT_transform_feedback) {
+      bits[bit_count++] = 0x800;
+      bits[bit_count++] = 0x1000;
+   }
+   if (dev->base.vk.enabled_features.bufferDeviceAddress)
+      bits[bit_count++] = 0x20000;
+   if (VN_PERF(NO_FORMAT_PREFETCH) || like->pNext ||
+       !dev->base.vk.enabled_features.maintenance4)
+      return;
+
+   VkBufferCreateInfo infos[2 * 14];
+   VkDeviceBufferMemoryRequirements dinfos[2 * 14];
+   VkMemoryRequirements2 reqs[2 * 14];
+   VkMemoryDedicatedRequirements dedicated[2 * 14];
+   struct vn_buffer_reqs_cache_entry *entries[2 * 14];
+   uint32_t n = 0;
+   for (uint32_t i = 0; i < 2 * bit_count; i++) {
+      VkBufferCreateInfo ci = *like;
+      ci.usage = bits[i / 2] | ((i & 1) ? 0x3 : 0);
+      uint64_t idx = vn_buffer_get_cache_index(&ci, cache);
+      if (!idx)
+         continue;
+      struct vn_buffer_reqs_cache_entry *entry =
+         util_sparse_array_get(&cache->entries, idx);
+      if (entry->valid)
+         continue;
+      bool dup = false;
+      for (uint32_t j = 0; j < n; j++)
+         dup = dup || entries[j] == entry;
+      if (dup)
+         continue;
+      infos[n] = ci;
+      dinfos[n] = (VkDeviceBufferMemoryRequirements){
+         .sType = VK_STRUCTURE_TYPE_DEVICE_BUFFER_MEMORY_REQUIREMENTS,
+         .pCreateInfo = &infos[n],
+      };
+      dedicated[n] = (VkMemoryDedicatedRequirements){
+         .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS };
+      reqs[n] = (VkMemoryRequirements2){
+         .sType = VK_STRUCTURE_TYPE_MEMORY_REQUIREMENTS_2,
+         .pNext = &dedicated[n] };
+      entries[n] = entry;
+      n++;
+   }
+   if (n < 2)
+      return;
+
+   VkDevice device = vn_device_to_handle(dev);
+   size_t cmd_size = 0, reply_size = 0;
+   for (uint32_t i = 0; i < n; i++) {
+      cmd_size += vn_sizeof_vkGetDeviceBufferMemoryRequirements(
+         device, &dinfos[i], &reqs[i]);
+      reply_size += vn_sizeof_vkGetDeviceBufferMemoryRequirements_reply(
+         device, &dinfos[i], &reqs[i]);
+   }
+   void *cmd_data = malloc(cmd_size);
+   if (!cmd_data)
+      return;
+   struct vn_ring_submit_command submit;
+   struct vn_cs_encoder *enc = vn_ring_submit_command_init(
+      dev->primary_ring, &submit, cmd_data, cmd_size, reply_size);
+   for (uint32_t i = 0; i < n; i++) {
+      vn_encode_vkGetDeviceBufferMemoryRequirements(
+         enc, VK_COMMAND_GENERATE_REPLY_BIT_EXT, device, &dinfos[i],
+         &reqs[i]);
+   }
+   vn_ring_submit_command(dev->primary_ring, &submit);
+   free(cmd_data);
+
+   struct vn_cs_decoder *dec =
+      vn_ring_get_command_reply(dev->primary_ring, &submit);
+   if (!dec)
+      return;
+   for (uint32_t i = 0; i < n; i++) {
+      vn_decode_vkGetDeviceBufferMemoryRequirements_reply(
+         dec, device, &dinfos[i], &reqs[i]);
+      vn_buffer_reqs_cache_entry_init(cache, entries[i], &reqs[i]);
+   }
+   vn_ring_free_command_reply(dev->primary_ring, &submit);
+}
