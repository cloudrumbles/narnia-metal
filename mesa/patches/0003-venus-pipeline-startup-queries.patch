+      { 1000288000, 1000288029 }, /* ASTC 3D */
+      { 1000330000, 1000330003 }, /* 16 bit 444 / 8 bit 444 */
+      { 1000340000, 1000340001 }, /* 4444 */
+      { 1000460000, 1000460003 },
