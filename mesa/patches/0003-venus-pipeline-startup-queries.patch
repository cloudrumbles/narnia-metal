+       */
+      struct vn_ring_submit_command create_submit, reqs_submit;
+      vn_ring_defer_reply_waits(true);
+      vn_submit_vkCreateBuffer(dev->primary_ring,
+                               VK_COMMAND_GENERATE_REPLY_BIT_EXT, dev_handle,
+                               create_info, NULL, &buf_handle,
+                               &create_submit);
+      vn_submit_vkGetBufferMemoryRequirements2(
+         dev->primary_ring, VK_COMMAND_GENERATE_REPLY_BIT_EXT, dev_handle,
+         &reqs_info, &buf->requirements.memory, &reqs_submit);
+      vn_ring_defer_reply_waits(false);
+
+      vn_ring_wait_command_reply(dev->primary_ring, &create_submit);
+      vn_ring_wait_command_reply(dev->primary_ring, &reqs_submit);
+      struct vn_cs_decoder *cdec =
+         vn_ring_get_command_reply(dev->primary_ring, &create_submit);
+      struct vn_cs_decoder *rdec =
+         vn_ring_get_command_reply(dev->primary_ring, &reqs_submit);
+      if (!cdec || !rdec) {
+         if (cdec)
+            vn_ring_free_command_reply(dev->primary_ring, &create_submit);
+         if (rdec)
+            vn_ring_free_command_reply(dev->primary_ring, &reqs_submit);
+         return VK_ERROR_OUT_OF_HOST_MEMORY;
+      }
+      result = vn_decode_vkCreateBuffer_reply(cdec, dev_handle, create_info,
+                                              NULL, &buf_handle);
+      vn_decode_vkGetBufferMemoryRequirements2_reply(
+         rdec, dev_handle, &reqs_info, &buf->requirements.memory);
+      vn_ring_free_command_reply(dev->primary_ring, &create_submit);
+      vn_ring_free_command_reply(dev->primary_ring, &reqs_submit);
+      if (result != VK_SUCCESS)
+         return result;
+   } else {
+      result = vn_call_vkCreateBuffer(dev->primary_ring, dev_handle,
+                                      create_info, NULL, &buf_handle);
+      if (result != VK_SUCCESS)
+         return result;
+
+      vn_call_vkGetBufferMemoryRequirements2(
+         dev->primary_ring, dev_handle, &reqs_info,
